# Variáveis do docker-compose.prod.yml (raiz do projeto)

# Senha do usuário da aplicação no MySQL.
# Deve ser a MESMA de DB_PASSWORD em backend/.env
DB_PASSWORD=troque-esta-senha

# Usuário e banco criados na primeira subida
DB_USER=priceasy
DB_NAME=priceasy

# Caminho da API usado no build do frontend.
# "/api" faz o nginx da stack fazer proxy para o backend.
VITE_API_URL=/api
