# Variáveis do docker-compose.prod.yml (raiz do projeto)

# Senha do root do MySQL em container.
# Deve ser a MESMA de DB_PASSWORD em backend/.env quando DB_USER=root
DB_ROOT_PASSWORD=troque-esta-senha

# Nome do banco criado na primeira subida
DB_NAME=priceasy

# Caminho da API usado no build do frontend.
# "/api" faz o Nginx do próprio frontend fazer proxy para o backend.
VITE_API_URL=/api
