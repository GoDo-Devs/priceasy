# URL pública do frontend (usada pelo CORS)
FRONTEND_URL=http://SEU_IP

# Banco de dados
# Em produção com docker-compose.prod.yml, DB_HOST é sobrescrito para "db"
DB_HOST=db
DB_USER=root
DB_PASSWORD=troque-esta-senha
DB_NAME=priceasy

# Autenticação
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria

# SMTP (envio de e-mails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app
EMAIL_FROM=seu-email@gmail.com

# Integrações
API_PLATE_KEY=sua-chave
